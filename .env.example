# Everything here is optional — the sync works with no credentials at all,
# reading the playlist off Spotify's public embed page.
#
# These are used only by the sync (locally, in GitHub Actions, or by the
# in-app sync button). None of them are exposed to the browser.

# The playlist to mirror. Full URL, spotify:playlist:... URI, or bare ID.
# Defaults to the Prit playlist if unset.
SPOTIFY_PLAYLIST=https://open.spotify.com/playlist/0BYFO12JqbeR5S2sWTUjRU

# The official Spotify API — needed for playlists longer than 100 tracks, and
# for album art. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Required alongside the two above. Spotify will not let an app-only token read
# playlist contents: it authenticates, then answers 403 on every track endpoint,
# because there's no user behind it. Run `npm run spotify-auth` once to get a
# refresh token — it doesn't expire.
SPOTIFY_REFRESH_TOKEN=

# Alternative to the above for a single run: a ready-made bearer token. These
# expire about an hour after they're issued, so don't rely on one.
SPOTIFY_TOKEN=

# Optional: makes YouTube matching faster and more accurate, but is capped at
# ~100 new songs/day. Without it, sync reads YouTube's public search page.
# https://console.cloud.google.com -> enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Optional: require this value as an x-sync-token header on POST /api/sync.
# Leave unset and the in-app sync button works for any visitor.
SYNC_TOKEN=

# Optional: minimum gap between manual syncs. Default 10 minutes.
SYNC_COOLDOWN_MS=

# Optional sync tuning.
#   SYNC_CONCURRENCY        parallel song lookups (default 6). Lower it if
#                           YouTube starts returning empty results.
#   SYNC_CHECKPOINT_EVERY   save partial progress every N lookups (default 25)
#   SYNC_REQUEST_TIMEOUT_MS per-request deadline (default 15000)
SYNC_CONCURRENCY=
SYNC_CHECKPOINT_EVERY=
SYNC_REQUEST_TIMEOUT_MS=
